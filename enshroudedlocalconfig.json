{
  "ApplicationName": "Enshrouded (Local)",
  "AppId": "enshroudedlocal",
  "Author": "Custom",
  "Description": "Enshrouded server running local pre-existing Windows files via Proton/Wine without SteamCMD updates.",
  "SupportedOS": [
    "Linux",
    "Windows"
  ],
  "ManagementType": "StandardIO",
  "ConsoleReading": true,
  "ConsoleWriting": true,
  "Ports": [
    {
      "PortNumber": 15636,
      "UsageType": "ApplicationPort",
      "Name": "Game Port"
    },
    {
      "PortNumber": 15637,
      "UsageType": "SteamQueryPort",
      "Name": "Query Port"
    }
  ],
  "UpdateMethod": "None",
  "WindowsExecutable": "enshrouded_server.exe",
  "LinuxExecutable": "enshrouded_server.exe",
  "LinuxUseProton": true,
  "StartupMode": "Standard",
  "StartupConfirmation": "Immediate",
  "ShutdownMethod": "WM_CLOSE",
  "ConfigFileHandled": "enshrouded_server.json",
  "ConfigFileType": "json",
