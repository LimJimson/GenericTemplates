Application.ID=enshroudedlocal
Application.Module=GenericModule
GenericModule.Meta.AppConfigId=enshroudedlocal
App.AdminMethod=STDIO
App.ApplicationPort1=15636
App.ApplicationPort2=15637
App.ApplicationReadyMode=Immediate
App.BaseDirectory=./enshroudedlocal/
App.CommandLineArgs=
App.CommandLineParameterDelimiter= 
App.CommandLineParameterFormat=-{0} "{1}"
App.ConfigFileHandled=enshrouded_server.json
App.ConfigFileType=json
App.DisplayName=Enshrouded (Local)
App.ExecutableLinux=enshrouded_server.exe
App.ExecutableWin=enshrouded_server.exe
App.ExitMethod=WM_CLOSE
App.ExitString=stop
App.HasReadableConsole=true
App.HasWritableConsole=true
App.LinuxUseProton=true
App.RapidStartup=false
App.RootDir=./enshroudedlocal/
App.UpdateSource=None
App.WorkingDir=
Console.AppReadyRegex=^Server is ready\.$
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserChatRegex=^(?<username>.+?): (?<message>.+)$
Console.UserJoinRegex=^User (?<username>.+?) \((?<userid>-?\d+)\) connected from \[::ffff:(?<endpoint>.+?)\]$
Console.UserLeaveRegex=^User (?<username>.+?) \((?<userid>-?\d+)\) disconnected\. Reason: (.+?)$
Meta.Author=Jimson
Meta.ConfigManifest=enshroudedlocalconfig.json
Meta.ConfigRoot=enshroudedlocal.kvp
Meta.Description=Enshrouded server running local pre-existing Windows files via Proton/Wine without SteamCMD updates.
Meta.DisplayImageSource=url:https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1203620/7b462e81072e94d96cb4242a75f8adddd9ec1cbd/header.jpg
Meta.DisplayName=Enshrouded (Local)
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.ApplicationPort2}
Meta.OS=3
Meta.URL=https://enshrouded.com/
